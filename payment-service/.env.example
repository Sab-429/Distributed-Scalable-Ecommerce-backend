# ── HTTP Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8083

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local:  postgresql://user:password@localhost:5432/payment_db?sslmode=disable
# Neon:   postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
#
# The service only creates/uses the `payments` table, so pointing it at the
# same Postgres database as order-service is fine. Use a dedicated database
# (`payment_db`) if you prefer strict separation.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/payment_db?sslmode=disable

# ── RabbitMQ (must match order-service) ──────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# ── Consumer ─────────────────────────────────────────────────────────────────
# Times a failed message is republished to the retry exchange before it is
# dead-lettered.
MAX_RETRIES=3

# ── Simulated payment gateway ────────────────────────────────────────────────
# Payment method applied to payments created from an order.created event.
DEFAULT_PAYMENT_METHOD=card
# Artificial latency (milliseconds) of a gateway charge call.
SIMULATED_LATENCY_MS=300
# Charge the simulated gateway with payment_method=declined to force a failure.
