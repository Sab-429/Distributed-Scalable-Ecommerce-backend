# ── HTTP Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8083

# ── PostgreSQL (local, same instance as auth_db / product_db) ─────────────────
# Dedicated database: the service only creates/uses the `payments` table.
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=payment_db

# ── RabbitMQ (must match order-service) ──────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# ── Consumer ─────────────────────────────────────────────────────────────────
# Times a failed message is republished to the retry exchange before it is
# dead-lettered.
MAX_RETRIES=3

# ── Simulated payment gateway ────────────────────────────────────────────────
# Payment method applied to payments created from an order.created event.
DEFAULT_PAYMENT_METHOD=card
# Artificial latency (milliseconds) of a gateway charge call.
SIMULATED_LATENCY_MS=300
# Charge the simulated gateway with payment_method=declined to force a failure.
