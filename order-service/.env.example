# ── HTTP Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8082

# ── PostgreSQL (local, same instance as auth_db / product_db) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=order_db

# ── gRPC — product-service ────────────────────────────────────────────────────
PRODUCT_SERVICE_URL=localhost:50051

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# ── Consumer ─────────────────────────────────────────────────────────────────
# Times a failed payment message is republished before it is dead-lettered.
MAX_RETRIES=3

# ── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=info
