# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=auth_db

# ── HTTP Server ───────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long random string — must match JWT_SECRET in api-gateway
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY_HOURS=24
JWT_ISSUER=auth-service

# ── Refresh Token ─────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRY_DAYS=7
