# =============================================================================
# distributed-service — environment variable reference
#
# Each service has its own .env file in its own directory.
# Copy the relevant .env.example and fill in real values:
#
#   cp product-service/.env.example  product-service/.env
#   cp Auth-service/.env.example     Auth-service/.env
#   cp order-service/.env.example    order-service/.env
#   cp api-gateway/.env.example      api-gateway/.env
#
# NEVER commit a real .env file — they are all listed in .gitignore.
# =============================================================================


# ── product-service  (HTTP :8080 | gRPC :50051) ───────────────────────────────
# See: product-service/.env.example


# ── Auth-service  (HTTP :8081) ────────────────────────────────────────────────
# See: Auth-service/.env.example
#
# NOTE: JWT_SECRET and JWT_ISSUER must be identical in Auth-service and api-gateway.


# ── order-service  (HTTP :8082) ───────────────────────────────────────────────
# See: order-service/.env.example
#
# NOTE: DATABASE_URL supports both local Postgres and hosted providers (e.g. Neon).


# ── api-gateway  (HTTP :8000) ─────────────────────────────────────────────────
# See: api-gateway/.env.example
